{
    "name": "berescms/berescms",
    "description": "Free, open-source content management system based on the Laravel PHP framework. Independent fork of Winter CMS.",
    "homepage": "https://github.com/DyanGalih/berescms",
    "type": "project",
    "keywords": ["berescms", "cms", "wintercms", "laravel", "cmf"],
    "license": "MIT",
    "authors": [
        {
            "name": "Dyan Galih",
            "role": "Fork Maintainer"
        },
        {
            "name": "Alexey Bobkov",
            "email": "aleksey.bobkov@gmail.com",
            "role": "Original Author"
        },
        {
            "name": "Samuel Georges",
            "email": "daftspunky@gmail.com",
            "role": "Original Author"
        },
        {
            "name": "Luke Towers",
            "email": "wintercms@luketowers.ca",
            "role": "Winter Lead Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/DyanGalih/berescms/issues",
        "source": "https://github.com/DyanGalih/berescms"
    },
    "require": {
        "php": ">=8.2",
        "laravel/framework": "^11.0|^12.0",
        "composer/semver": "^3.2|^4.0",
        "assetic/framework": "^3.2.3",
        "doctrine/dbal": "^3.0",
        "enshrined/svg-sanitize": "~1.0",
        "laravel/tinker": "^2.8.1|^3.0",
        "league/commonmark": "^2.10.2",
        "league/csv": "~9.1",
        "nesbot/carbon": "^3.0",
        "scssphp/scssphp": "~1.0",
        "symfony/console": "^7.2",
        "symfony/process": "^7.1",
        "symfony/yaml": "^6.4|^7.0",
        "twig/twig": "^3.21",
        "wikimedia/less.php": "^5.0",
        "wikimedia/minify": "~2.2",
        "winter/laravel-config-writer": "^1.2.0"
    },
    "replace": {
        "winter/storm": "self.version",
        "berescms/storm": "self.version",
        "october/rain": "self.version",
        "winter/wn-system-module": "self.version",
        "winter/wn-backend-module": "self.version",
        "winter/wn-cms-module": "self.version"
    },
    "autoload": {
        "files": [
            "modules/storm/src/Support/aliases.php",
            "modules/storm/src/Support/helpers.php",
            "modules/storm/src/Router/helpers.php",
            "modules/storm/src/Html/helpers.php"
        ],
        "psr-4": {
            "Winter\\Storm\\": "modules/storm/src/",
            "System\\": "modules/system/",
            "Backend\\": "modules/backend/",
            "Cms\\": "modules/cms/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Winter\\Storm\\Tests\\": "modules/storm/tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5.0 <11.0.0",
        "mockery/mockery": "^1.4.4",
        "fakerphp/faker": "^1.9.2",
        "squizlabs/php_codesniffer": "^3.2",
        "php-parallel-lint/php-parallel-lint": "^1.0",
        "meyfa/phpunit-assert-gd": "^4.2",
        "orchestra/testbench": "^9.0"
    },
    "scripts": {
        "post-create-project-cmd": [
            "@php artisan winter:install",
            "@php artisan winter:env",
            "@php artisan winter:mirror public --relative"
        ],
        "post-update-cmd": [
            "@php artisan winter:version",
            "@php artisan package:discover"
        ],
        "test": [
            "phpunit --stop-on-failure"
        ],
        "lint": [
            "parallel-lint --exclude vendor --exclude storage --exclude modules/system/tests/fixtures/plugins/testvendor/goto/Plugin.php ."
        ],
        "sniff": [
            "phpcs --colors -nq --report=\"full\" --extensions=\"php\""
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "policy": {
            "advisories": {
                "ignore": {
                    "laravel/framework": {
                        "on-audit": false,
                        "reason": "Approved exception for framework advisory in monorepo environment"
                    }
                }
            }
        },
        "allow-plugins": {
            "composer/installers": true
        }
    }
}
