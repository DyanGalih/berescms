{
    "name": "berescms/berescms",
    "description": "Free, open-source content management system based on the Laravel PHP framework. Independent fork of Winter CMS.",
    "homepage": "https://github.com/DyanGalih/berescms",
    "type": "project",
    "keywords": ["berescms", "cms", "wintercms", "laravel", "cmf"],
    "license": "MIT",
    "authors": [
        {
            "name": "Dyan Galih",
            "role": "Fork Maintainer"
        },
        {
            "name": "Alexey Bobkov",
            "email": "aleksey.bobkov@gmail.com",
            "role": "Original Author"
        },
        {
            "name": "Samuel Georges",
            "email": "daftspunky@gmail.com",
            "role": "Original Author"
        },
        {
            "name": "Luke Towers",
            "email": "wintercms@luketowers.ca",
            "role": "Winter Lead Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/DyanGalih/berescms/issues",
        "source": "https://github.com/DyanGalih/berescms"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/DyanGalih/storm.git"
        }
    ],
    "require": {
        "php": ">=8.2",
        "winter/storm": "dev-feature/modern-laravel as 1.3",
        "winter/wn-system-module": "dev-develop",
        "winter/wn-backend-module": "dev-develop",
        "winter/wn-cms-module": "dev-develop",
        "laravel/framework": "^11.0|^12.0",
        "wikimedia/composer-merge-plugin": "~2.1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5|^11.0",
        "mockery/mockery": "^1.4.4",
        "fakerphp/faker": "^1.9.2",
        "squizlabs/php_codesniffer": "^3.2",
        "php-parallel-lint/php-parallel-lint": "^1.0",
        "dms/phpunit-arraysubset-asserts": "^0.1.0|^0.2.1"
    },
    "scripts": {
        "post-create-project-cmd": [
            "@php artisan winter:install",
            "@php artisan winter:env",
            "@php artisan winter:mirror public --relative"
        ],
        "post-update-cmd": [
            "@php artisan winter:version",
            "@php artisan package:discover"
        ],
        "test": [
            "phpunit --stop-on-failure"
        ],
        "lint": [
            "parallel-lint --exclude vendor --exclude storage --exclude modules/system/tests/fixtures/plugins/testvendor/goto/Plugin.php ."
        ],
        "sniff": [
            "phpcs --colors -nq --report=\"full\" --extensions=\"php\""
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "merge-plugin": {
            "include": [
                "plugins/myauthor/*/composer.json"
            ],
            "recurse": true,
            "replace": false,
            "merge-replace": false,
            "merge-dev": false
        }
    },
    "config": {
        "policy": {
            "advisories": {
                "ignore": {
                    "laravel/framework": {
                        "on-audit": false,
                        "reason": "Winter CMS 1.2 requires Laravel 9"
                    }
                }
            }
        },
        "allow-plugins": {
            "composer/installers": true,
            "wikimedia/composer-merge-plugin": true
        }
    }
}
